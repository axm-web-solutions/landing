# Lead storage (server-only — never prefix with NEXT_PUBLIC_).
# Supabase project URL and service role key: Project Settings → API.
# Without these, leads are written to .data/leads.jsonl in development and rejected in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to "leads"
SUPABASE_LEADS_TABLE=leads

# Lead notifications (optional, server-only). Each channel turns on when its vars are set.
# Email via Resend (https://resend.com → API Keys). Comma-separated recipients.
# Without a verified domain, onboarding@resend.dev only delivers to the Resend account owner.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL_TO=
LEAD_NOTIFY_EMAIL_FROM=EdiFeasy <leads@tudominio.com>
# WhatsApp via CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/).
# One "phone:apikey" pair per recipient, comma-separated: +573001234567:123456
CALLMEBOT_WHATSAPP=
